# Every pinned identity experiment 18 depends on. Sourced by 18_converter_comparison.sh and passed
# to each Dockerfile as build arguments, so a rebuild resolves to the same bytes.
#
# Base image and packages: one Debian base pinned by digest, with packages taken from the Debian
# snapshot archive at a fixed date rather than from the moving mirror.
CONV_BASE_IMAGE="debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
CONV_DEBIAN_SNAPSHOT="20261008T000000Z"

# The validator, QLever, cyvcf2, and bcftools: VCF-RDFizer v3.3.1, by digest.
CONV_VCFRDFIZER_IMAGE="ecrum19/vcf-rdfizer@sha256:3ad71b1a54612142e3be43b24e7e4a38551949cb641f4421bcae9bf051102993"
CONV_VCFRDFIZER_VERSION="3.3.1"

# Apache Jena riot, which streams each converter's native RDF to N-Triples.
CONV_JENA_VERSION="6.2.0"
CONV_JENA_SHA512="2b467d2ff940c207aea935e012ecbb0f0ab3e6bf59b3fc4b3fbc6cf9cea11f1428e97882ec078a5ffc57e114e0f5c88ea98c4575e687cc1dd232f99324b7b2a2"

