CONV_VCFRDFIZER_SOURCE_SHA256="873a8cda3b495bc96dfc7342a7d531baff527e55e3a1d15bf9038aeb9f6c4172"

# JVarkit vcf2rdf: built from this commit (the v2026.04.30 tag was moved after release, so the
# commit is the pin). Gradle 8.5's published distribution checksum, which the wrapper lacks.
CONV_JVARKIT_COMMIT="fc2356a347e1ec9b12d586c7a096c0d61bfbe8c1"
CONV_GRADLE_SHA256="9d926787066a081739e8200858338b4a69e837c3a821a33aca9db09dd4a41026"

# TogoVar vcf2rdf v1.0.0-beta.12 (commit f17835a6): the upstream Docker Hub image, by index digest.
