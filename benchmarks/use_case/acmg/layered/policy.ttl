@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix vcfp: <https://w3id.org/vcf-rdfizer/policy#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix vcfl: <https://w3id.org/vcf-rdfizer/linking#> .
@prefix ensembl: <https://identifiers.org/ensembl:> .
@prefix ex:   <https://example.org/policy/acmg-use-case/> .

# --- Cohort rule -------------------------------------------------------------

# The cohort rule's target: records whose call overlaps one of these Ensembl
# genes (vcfl:overlapsGene, written by the ensembl-genes-grch38 linker), through
# the LinkedSelector the VCF Core profile ships. The panel is data, not SPARQL,
# and the selector refuses a graph evaluated without its gene links.
ex:cancer-predisposition a odrl:Asset , vcfp:GraphSelection ;
    vcfp:selector [ a vcfp:LinkedSelector ; vcfp:predicate vcfl:overlapsGene ;
                    vcfp:entities (
        ensembl:ENSG00000134982  # APC
        ensembl:ENSG00000107779  # BMPR1A
        ensembl:ENSG00000012048  # BRCA1
        ensembl:ENSG00000139618  # BRCA2
        ensembl:ENSG00000125952  # MAX
        ensembl:ENSG00000133895  # MEN1
        ensembl:ENSG00000076242  # MLH1
        ensembl:ENSG00000095002  # MSH2
        ensembl:ENSG00000116062  # MSH6
        ensembl:ENSG00000132781  # MUTYH
        ensembl:ENSG00000186575  # NF2
        ensembl:ENSG00000083093  # PALB2
        ensembl:ENSG00000122512  # PMS2
        ensembl:ENSG00000171862  # PTEN
        ensembl:ENSG00000139687  # RB1
        ensembl:ENSG00000165731  # RET
        ensembl:ENSG00000167985  # SDHAF2
        ensembl:ENSG00000117118  # SDHB
        ensembl:ENSG00000143252  # SDHC
        ensembl:ENSG00000204370  # SDHD
        ensembl:ENSG00000141646  # SMAD4
        ensembl:ENSG00000118046  # STK11
        ensembl:ENSG00000135956  # TMEM127
        ensembl:ENSG00000141510  # TP53
        ensembl:ENSG00000165699  # TSC1
        ensembl:ENSG00000103197  # TSC2
        ensembl:ENSG00000134086  # VHL
        ensembl:ENSG00000184937  # WT1
    ) ] .

ex:cohort a odrl:Set ; odrl:uid ex:cohort ;
    odrl:profile <https://w3id.org/vcf-rdfizer/policy> ; odrl:conflict odrl:prohibit ;
    # Secondary findings in cancer-predisposition genes: clinical care only.
    odrl:prohibition [ odrl:target ex:cancer-predisposition ; odrl:action odrl:read ; odrl:assignee odrl:All ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:isNoneOf ;
                          odrl:rightOperand obo:DUO_0000043 ] ] .

# --- Participant consents (simulated) -----------------------------------------

ex:consent-NB72462M a odrl:Set ; odrl:uid ex:consent-NB72462M ;
    odrl:profile <https://w3id.org/vcf-rdfizer/policy> ; odrl:conflict odrl:prohibit ;
    odrl:permission [ odrl:target <file://NB72462M.acmg.vcf> ; odrl:action odrl:read ; odrl:assignee odrl:All ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:isAnyOf ;
                          odrl:rightOperand obo:DUO_0000043 , obo:DUO_0000042 ] ] .

# --- Finer rules (arm 4) -------------------------------------------------------

# 40 genes; Disease-specific research receives only records whose REF extent overlaps one of these genes; everything else in the file is withheld from it.
ex:OutsidePanel1 a vcfp:SelectorType ;
    vcfp:query """
        PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
        PREFIX vcfl: <https://w3id.org/vcf-rdfizer/linking#>
        PREFIX ensembl: <https://identifiers.org/ensembl:>
        SELECT ?resource WHERE {
            ?resource a vcfc:VCFRecord .
            MINUS { ?resource vcfc:hasCall ?call . ?call vcfl:overlapsGene ?gene .
                    VALUES ?gene { ensembl:ENSG00000107796 ensembl:ENSG00000159251 ensembl:ENSG00000084674 ensembl:ENSG00000151929 ensembl:ENSG00000198668 ensembl:ENSG00000143933 ensembl:ENSG00000160014 ensembl:ENSG00000118729 ensembl:ENSG00000168542 ensembl:ENSG00000175084 ensembl:ENSG00000134755 ensembl:ENSG00000046604 ensembl:ENSG00000096696 ensembl:ENSG00000166147 ensembl:ENSG00000128591 ensembl:ENSG00000055118 ensembl:ENSG00000053918 ensembl:ENSG00000130164 ensembl:ENSG00000160789 ensembl:ENSG00000134571 ensembl:ENSG00000133392 ensembl:ENSG00000092054 ensembl:ENSG00000111245 ensembl:ENSG00000160808 ensembl:ENSG00000169174 ensembl:ENSG00000057294 ensembl:ENSG00000106617 ensembl:ENSG00000203867 ensembl:ENSG00000198626 ensembl:ENSG00000183873 ensembl:ENSG00000166949 ensembl:ENSG00000106799 ensembl:ENSG00000163513 ensembl:ENSG00000170876 ensembl:ENSG00000114854 ensembl:ENSG00000129991 ensembl:ENSG00000118194 ensembl:ENSG00000140416 ensembl:ENSG00000186439 ensembl:ENSG00000155657 } } }""" ;
    vcfp:violations """
        PREFIX vcfl: <https://w3id.org/vcf-rdfizer/linking#>
        SELECT ?missing WHERE {
            BIND("no vcfl:overlapsGene links in the graph" AS ?missing)
            FILTER NOT EXISTS { ?anything vcfl:overlapsGene ?gene } }""" .
ex:outside-panel-1 a odrl:Asset , vcfp:GraphSelection ; vcfp:selector [ a ex:OutsidePanel1 ] .
ex:outside_panel_1 a odrl:Set ; odrl:uid ex:outside_panel_1 ;
    odrl:profile <https://w3id.org/vcf-rdfizer/policy> ; odrl:conflict odrl:prohibit ;
    odrl:prohibition [ odrl:target ex:outside-panel-1 ; odrl:action odrl:read ; odrl:assignee odrl:All ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:isAnyOf ;
                          odrl:rightOperand obo:DUO_0000007 ] ] .

# APOE, chr19:44903787-44909396 (Ensembl release 116, ENSG00000130203, gene span). Records whose POS lies in the span are released only for care by the participant's own physician. The region is coordinates on a named contig, so it binds the contig name as the file writes it.
ex:region-apoe a odrl:Asset , vcfp:GraphSelection ;
    vcfp:selector [ a vcfp:RegionSelector ; vcfp:assembly "GCA_000001405.15_GRCh38_no_alt_analysis_set" ;
                    vcfp:chrom "chr19" ; vcfp:start 44903787 ; vcfp:end 44909396 ] .
ex:region_apoe a odrl:Set ; odrl:uid ex:region_apoe ;
    odrl:profile <https://w3id.org/vcf-rdfizer/policy> ; odrl:conflict odrl:prohibit ;
    odrl:prohibition [ odrl:target ex:region-apoe ; odrl:action odrl:read ; odrl:assignee odrl:All ;
        odrl:constraint [ odrl:leftOperand odrl:purpose ; odrl:operator odrl:isNoneOf ;
                          odrl:rightOperand <https://example.org/purpose/own-physician-care> ] ] .

# DSP chr6:7569314 C>G, uncertain significance. Withheld from the biobank by name, whatever its purpose; the target is the variant's SPDI identity, so it holds whatever the file calls chromosome 6.
ex:variant-1 a odrl:Asset , vcfp:GraphSelection ;
    vcfp:selector [ a vcfp:LinkedSelector ; vcfp:predicate vcfl:sameVariantAs ;
                    vcfp:entities ( <https://api.ncbi.nlm.nih.gov/variation/v0/spdi/NC_000006.12:7569313:C:G> ) ] .
ex:variant_1 a odrl:Set ; odrl:uid ex:variant_1 ;
    odrl:profile <https://w3id.org/vcf-rdfizer/policy> ; odrl:conflict odrl:prohibit ;
    odrl:prohibition [ odrl:target ex:variant-1 ; odrl:action odrl:read ;
        odrl:assignee <https://example.org/party/biobank-researcher> ] .
