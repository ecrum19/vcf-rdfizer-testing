  BIND(STR(?lexLiteral) AS ?lex)
  BIND(SUBSTR(SHA256(CONCAT(STR(?value), "\u001F", STR(?lex))), 1, 2) AS ?bucket)
}
GROUP BY ?bucket
ORDER BY ?bucket

