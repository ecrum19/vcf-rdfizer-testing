PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>

# How many distinct triples the graph contains.
#
# A SPARQL store holds a set, so a duplicated line in the N-Triples file is
# invisible to every other query here: the store collapses it on load. The only
# way to see duplication is to compare this against the number of statements the
# parser actually read, which the Raptor step records. The difference is exactly
# the number of redundant lines.
#
# This matters because duplicate RDF parts are a known failure mode of the
# conversion - run_conversion.sh already carries a defensive dedupe for it - and
# a duplicated aggregate is twice the size for no added information.
SELECT (COUNT(*) AS ?distinctTripleCount)
WHERE {
  ?s ?p ?o .
}

