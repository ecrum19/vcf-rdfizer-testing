PREFIX gvo: <http://genome-variation.org/resource#>
PREFIX faldo: <http://biohackathon.org/resource/faldo#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# TogoVar vcf2rdf v1.0.0-beta.12, run with --no-normalize so gvo:pos/ref/alt keep the VCF values.
# It writes one node per ALT allele and no node for the record, so records are regrouped on
# (reference, POS, REF, ID), all of which every allele node carries.
# CHROM is not written: TogoVar replaces it with the reference IRI its configuration assigns.
# VALUES (?seq ?chrom) { (<http://identifiers.org/hco/1/GRCh38> "chr1") (<http://identifiers.org/hco/10/GRCh38> "chr10") (<http://identifiers.org/hco/11/GRCh38> "chr11") (<http://identifiers.org/hco/12/GRCh38> "chr12") (<http://identifiers.org/hco/13/GRCh38> "chr13") (<http://identifiers.org/hco/14/GRCh38> "chr14") (<http://identifiers.org/hco/15/GRCh38> "chr15") (<http://identifiers.org/hco/16/GRCh38> "chr16") (<http://identifiers.org/hco/17/GRCh38> "chr17") (<http://identifiers.org/hco/18/GRCh38> "chr18") (<http://identifiers.org/hco/19/GRCh38> "chr19") (<http://identifiers.org/hco/2/GRCh38> "chr2") (<http://identifiers.org/hco/20/GRCh38> "chr20") (<http://identifiers.org/hco/21/GRCh38> "chr21") (<http://identifiers.org/hco/22/GRCh38> "chr22") (<http://identifiers.org/hco/3/GRCh38> "chr3") (<http://identifiers.org/hco/4/GRCh38> "chr4") (<http://identifiers.org/hco/5/GRCh38> "chr5") (<http://identifiers.org/hco/6/GRCh38> "chr6") (<http://identifiers.org/hco/7/GRCh38> "chr7") (<http://identifiers.org/hco/8/GRCh38> "chr8") (<http://identifiers.org/hco/9/GRCh38> "chr9") (<http://identifiers.org/hco/MT/GRCh38> "chrM") (<http://identifiers.org/hco/X/GRCh38> "chrX") (<http://identifiers.org/hco/Y/GRCh38> "chrY") } maps each IRI back to the CHROM it was assigned from, using the configuration
# file of this conversion (written by `vcf2rdf generate config`).
SELECT ?chrom ?windowIndex (COUNT(DISTINCT ?record) AS ?recordCount)
WHERE {
    ?allele gvo:pos ?pos ; gvo:ref ?refLiteral ; dct:identifier ?id ;
            faldo:location/(faldo:reference|faldo:begin/faldo:reference) ?seq .
    BIND(CONCAT(STR(?seq), "|", STR(?pos), "|", STR(?refLiteral), "|", STR(?id)) AS ?record)
  VALUES (?seq ?chrom) { (<http://identifiers.org/hco/1/GRCh38> "chr1") (<http://identifiers.org/hco/10/GRCh38> "chr10") (<http://identifiers.org/hco/11/GRCh38> "chr11") (<http://identifiers.org/hco/12/GRCh38> "chr12") (<http://identifiers.org/hco/13/GRCh38> "chr13") (<http://identifiers.org/hco/14/GRCh38> "chr14") (<http://identifiers.org/hco/15/GRCh38> "chr15") (<http://identifiers.org/hco/16/GRCh38> "chr16") (<http://identifiers.org/hco/17/GRCh38> "chr17") (<http://identifiers.org/hco/18/GRCh38> "chr18") (<http://identifiers.org/hco/19/GRCh38> "chr19") (<http://identifiers.org/hco/2/GRCh38> "chr2") (<http://identifiers.org/hco/20/GRCh38> "chr20") (<http://identifiers.org/hco/21/GRCh38> "chr21") (<http://identifiers.org/hco/22/GRCh38> "chr22") (<http://identifiers.org/hco/3/GRCh38> "chr3") (<http://identifiers.org/hco/4/GRCh38> "chr4") (<http://identifiers.org/hco/5/GRCh38> "chr5") (<http://identifiers.org/hco/6/GRCh38> "chr6") (<http://identifiers.org/hco/7/GRCh38> "chr7") (<http://identifiers.org/hco/8/GRCh38> "chr8") (<http://identifiers.org/hco/9/GRCh38> "chr9") (<http://identifiers.org/hco/MT/GRCh38> "chrM") (<http://identifiers.org/hco/X/GRCh38> "chrX") (<http://identifiers.org/hco/Y/GRCh38> "chrY") }
  BIND(xsd:integer(FLOOR((xsd:integer(?pos) - 1) / 1000000)) AS ?windowIndex)
}
GROUP BY ?chrom ?windowIndex
ORDER BY ?chrom ?windowIndex
