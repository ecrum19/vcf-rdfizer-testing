# Operating-system, editor and Python caches.
.DS_Store
.vscode/
__pycache__/

# Inputs and generated RDF are never committed. The VCFs come from their
# providers (README.md, Datasets), and every graph is regenerated by its
# archived command.
vcf_data/
*.hdt
*.nt
*.nt.gz

# A local benchmark run (benchmarks/README.md, Layout) writes under
# benchmarks/results/, or under benchmarks_outputs/ where BM_RESULTS points
# there, as on the benchmark hosts. Keep the run records, drop the bulk.
benchmarks/results/**/out/
benchmarks/results/**/*.log
benchmarks/results/**/workspace_bytes.tsv
benchmarks_outputs/**/out/
benchmarks_outputs/**/*.log
benchmarks_outputs/**/workspace_bytes.tsv
# Experiment 18's scratch (benchmarks/converters/run.sh, CONV_WORK).
.conv-work/

# Manuscript: sources, bibliography, PDFs and the build files only.
BioMedSem_2026/paper/*
!*.pdf
!*.tex
!*.bib
!*.png
!BioMedSem_2026/paper/Makefile
!BioMedSem_2026/paper/README.md
!BioMedSem_2026/paper/.latexmkrc
!BioMedSem_2026/paper/package.py
!BioMedSem_2026/paper/template/
!BioMedSem_2026/paper/template/sn-jnl.cls
!BioMedSem_2026/paper/template/bst/
!BioMedSem_2026/paper/template/bst/sn-mathphys-num.bst
# The manuscript's portable LaTeX Workshop recipe.
!BioMedSem_2026/paper/.vscode/
!BioMedSem_2026/paper/.vscode/settings.json

# Figure sources: the TikZ figures' LaTeX build files.
BioMedSem_2026/paper-assets/*.aux
BioMedSem_2026/paper-assets/*.log
BioMedSem_2026/paper-assets/*.fls
BioMedSem_2026/paper-assets/*.fdb_latexmk
BioMedSem_2026/paper-assets/*.synctex.gz

# Co-author brief: its sources, figures and PDF; not its LaTeX build files.
tool-docs/coauthor-report/*
!tool-docs/coauthor-report/*.pdf
!tool-docs/coauthor-report/*.tex
!tool-docs/coauthor-report/*.bib
!tool-docs/coauthor-report/*.png
!tool-docs/coauthor-report/figs/

# Results site data, built by scripts/build_site_data.py in CI.
site/data/
