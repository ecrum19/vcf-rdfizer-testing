PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>

SELECT ?an ?ac (COUNT(DISTINCT ?record) AS ?siteCount)
WHERE {
  {
    SELECT ?record (SUM(?anContribution) AS ?an) (SUM(?acContribution) AS ?ac)
    WHERE {
      {
        SELECT DISTINCT ?record ?sampleCall ?gt
        WHERE {
          ?record a vcfc:VCFRecord ; vcfc:alt ?altLiteral ; vcfc:hasCall ?call .
          FILTER(STR(?altLiteral) != "." && !CONTAINS(STR(?altLiteral), ","))
          ?call vcfc:hasSampleCall ?sampleCall .
          ?sampleCall vcfc:hasFormatValue ?gtValueNode .
          FILTER(STRENDS(STR(?gtValueNode), "/fmt/GT"))
          ?gtValueNode vcfc:fieldValue ?gtLiteral .
          BIND(REPLACE(STR(?gtLiteral), "[|]", "/") AS ?gt)
        }
      }
      BIND(IF(REGEX(?gt, "^[01]$"), 1, IF(REGEX(?gt, "^[01]/[01]$"), 2, 0)) AS ?anContribution)
      BIND(IF(?gt = "1", 1, IF(?gt = "0/1" || ?gt = "1/0", 1, IF(?gt = "1/1", 2, 0))) AS ?acContribution)
    }
    GROUP BY ?record
  }
  FILTER(?an > 0)
}
GROUP BY ?an ?ac
ORDER BY ?an ?ac

